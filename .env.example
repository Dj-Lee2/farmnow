# 이 파일을 .env 로 복사해 값을 채운다(.env 는 저장소에 올리지 않는다).
# 공공데이터포털 '기상청_기상특보 조회서비스' 인증키. 없으면 특보를 건너뛰고 '확인 불가'로 표시한다.
DATA_GO_KR_KEY=
# KAMIS 오픈API 인증키·아이디. 비우면 공개 테스트키를 쓴다.
KAMIS_KEY=
KAMIS_ID=
# 국가데이터처 KOSIS 오픈API 인증키(kosis.kr/openapi). 비우면 홈 농업 통계에서 KOSIS 칸을 뺀다.
KOSIS_API_KEY=
# 배포 주소(선택). 비우면 config/sources.yml 의 base_url 을 쓴다.
SITE_BASE_URL=
