diff --git a/templates/stats.html b/templates/stats.html
index ca47c60..f2bd716 100644
--- a/templates/stats.html
+++ b/templates/stats.html
@@ -2499,8 +2499,8 @@
   {{ card('gkx_co2', 'gkx1', ('총배출의 ' ~ '{:.1f}'.format(K.gkx_co2.vals[-1] / K.ghs_total.vals[-1] * 100) ~ '% · 연료 연소가 대부분') if K.ghs_total and K.gkx_co2 else none, '#7a6a3a') }}
   {{ card('gkx_ch4', 'gkx2', ('총배출의 ' ~ '{:.1f}'.format(K.gkx_ch4.vals[-1] / K.ghs_total.vals[-1] * 100) ~ '% · 벼논·가축·매립지') if K.ghs_total and K.gkx_ch4 else none, '#b07a3a') }}
   {{ card('gkx_n2o', 'gkx3', ('총배출의 ' ~ '{:.1f}'.format(K.gkx_n2o.vals[-1] / K.ghs_total.vals[-1] * 100) ~ '% · 질소 비료·분뇨·연소') if K.ghs_total and K.gkx_n2o else none, '#5a7a3a') }}
-  {{ rcard('국가 메탄 배출 중 농업 몫', K.ghm_ch4_agri, K.gkx_ch4, 'gkx4', '벼 재배·장내발효·분뇨처리 메탄 · 전년 대비', '#b07a3a') }}
-  {{ rcard('국가 아산화질소 배출 중 농업 몫', K.ghm_n2o_agri, K.gkx_n2o, 'gkx5', '농경지 토양·분뇨처리 아산화질소 · 전년 대비', '#5a7a3a') }}
+  {{ rcard('국가 메탄 배출 중 벼 재배 몫', K.ghs_rice, K.gkx_ch4, 'gkx4', '논 담수 상태에서 나오는 메탄 · 전년 대비', '#2458d6') }}
+  {{ rcard('국가 메탄 배출 중 가축 장내발효 몫', K.ghs_ent, K.gkx_ch4, 'gkx5', '소 되새김 등 소화 과정 메탄 · 전년 대비', '#b0503a') }}
   {{ rcard('총배출 중 불소계 가스(HFCs) 비중', K.gkx_hfc, K.ghs_total, 'gkx6', '냉매·발포제 · 시설원예 냉방·저온저장고 냉매 포함 · 전년 대비', '#2458d6') }}
   {{ hcard('국가 온실가스 기체별 배출', [('이산화탄소(CO₂)', K.gkx_co2), ('메탄(CH₄)', K.gkx_ch4), ('수소불화탄소(HFCs)', K.gkx_hfc), ('아산화질소(N₂O)', K.gkx_n2o), ('육불화황(SF₆)', K.gkx_sf6), ('과불화탄소(PFCs)', K.gkx_pfc), ('삼불화질소(NF₃)', K.gkx_nf3)], '백만톤', 'CO₂ 환산 · 괄호는 총배출 중 비중 · 오른쪽은 전년 대비', K.ghs_total.vals[-1] if K.ghs_total else none, '#7a6a3a') }}
